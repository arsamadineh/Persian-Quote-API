{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@persian-quote/schema": ["./packages/schema/src/index.ts"],
      "@persian-quote/schema/*": ["./packages/schema/src/*"],
      "@persian-quote/persian": ["./packages/persian/src/index.ts"],
      "@persian-quote/persian/*": ["./packages/persian/src/*"],
      "@persian-quote/poem": ["./packages/poem/src/index.ts"],
      "@persian-quote/poem/*": ["./packages/poem/src/*"],
      "@persian-quote/core": ["./packages/core/src/index.ts"],
      "@persian-quote/core/*": ["./packages/core/src/*"],
      "@/*": ["./*", "./apps/web/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
