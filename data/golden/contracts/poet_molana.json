        "id": "p-1",
        "kind": "poetry",
        "text_persian": "عاشقان مرده‌اند در عشق زنده / تا ابد در دل جانان پاینده",
        "text_english": "Lovers are dead in love, yet alive / Forever enduring in the beloved's heart",
        "poet": "مولانا جلال‌الدین رومی",
        "poet_english": "Rumi",
        "source": "دیوان شمس",
        "category": "عشق",
