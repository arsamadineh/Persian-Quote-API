      },
      {
        "id": "p-2",
        "kind": "poetry",
        "text_persian": "دوش از مسجد سوی میخانه آمد پیرِ ما / ای خدا این چه منزل است که پیر ما آمد",
        "text_english": "Last night our elder came from mosque to tavern / O God, what a station this is, that our elder came",
        "poet": "حافظ شیرازی",
        "poet_english": "Hafez",
        "source": "دیوان حافظ",
        "category": "عرفان",
